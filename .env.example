# Live World Cup match data — https://www.football-data.org
FOOTBALL_DATA_KEY=your_football_data_key_here

# OpenAI — used ONLY for the web-search features (/api/ai-search)
OPENAI_API_KEY=your_openai_key_here

# IBM watsonx.ai (Granite) — used for the chat features (/api/ai)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Optional — defaults to ibm/granite-3-8b-instruct if omitted
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Local dev server port (proxy.js)
PORT=3001
